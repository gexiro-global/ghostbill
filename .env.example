# ==============================================================================
# GhostBill Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Generate all secrets ON THE SERVER: openssl rand -hex 32
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME=GhostBill
APP_VERSION=0.1.0
SECRET_KEY=                          # openssl rand -hex 32
ENVIRONMENT=production               # production or development
DEBUG=false

# --- PostgreSQL ---
POSTGRES_USER=ghostbill
POSTGRES_PASSWORD=                   # openssl rand -hex 24
POSTGRES_DB=ghostbill
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- Encryption ---
MASTER_ENCRYPTION_KEY=               # openssl rand -hex 32 — encrypts view keys (AES-256-GCM)

# --- wallet-rpc ---
WALLET_RPC_HOST=172.23.0.1           # Docker bridge gateway IP (adjust for your network)
WALLET_RPC_PORT=18083
WALLET_RPC_USER=ghostbill
WALLET_RPC_PASS=                     # openssl rand -hex 32
WALLET_PASSWORD=                     # openssl rand -hex 32 — wallet file encryption password

# --- monerod ---
MONEROD_HOST=127.0.0.1
MONEROD_PORT=31208
MONEROD_RPC_USER=                    # Your monerod RPC username
MONEROD_RPC_PASS=                    # Your monerod RPC password

# --- Tor (optional) ---
TOR_SOCKS_PORT=9050
TOR_ENABLED=true                     # Set to false to disable Tor proxy for outgoing connections

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRICT=5                  # POST /v1/merchants — per hour
RATE_LIMIT_WRITE=60                  # Write endpoints — per minute
RATE_LIMIT_READ=120                  # Read endpoints — per minute
RATE_LIMIT_PUBLIC=300                # Public endpoints — per minute

# --- Data Retention ---
RETENTION_EXPIRED_INVOICES_HOURS=48  # Delete expired+unpaid invoices after N hours
RETENTION_WEBHOOKS_DAYS=30           # Delete webhook delivery logs after N days
RETENTION_AUDIT_DAYS=90              # Delete audit log entries after N days

# --- Price Feed ---
PRICE_FEED_INTERVAL=60               # Seconds between price updates
PRICE_FEED_SOURCE=coingecko          # Price data source

# --- Detection Engine ---
DETECTION_INTERVAL=30                # Seconds between payment detection cycles
CONFIRMATION_THRESHOLD=10            # Confirmations required for "confirmed" status
DUST_THRESHOLD_ATOMIC=100000000      # Minimum payment (0.0001 XMR) — below this is ignored

# --- Admin ---
ADMIN_MERCHANT_ID=                   # UUID of the merchant with admin panel access (optional)
