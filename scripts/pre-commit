#!/usr/bin/env bash
# GhostBill — Git pre-commit hook
# Runs ruff check + format on staged Python files
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

RUFF="/usr/local/bin/ruff"

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_PY" ]; then
    exit 0
fi

echo "[pre-commit] Checking $(echo "$STAGED_PY" | wc -l) Python file(s)..."

if [ ! -x "$RUFF" ]; then
    echo "[pre-commit] ERROR: ruff not found at $RUFF. Install: pip install ruff"
    exit 1
fi

echo "$STAGED_PY" | xargs $RUFF check --no-cache --config backend/pyproject.toml
if [ $? -ne 0 ]; then
    echo "[pre-commit] FAILED: ruff check found errors. Fix them before committing."
    exit 1
fi

echo "$STAGED_PY" | xargs $RUFF format --check --no-cache --config backend/pyproject.toml
if [ $? -ne 0 ]; then
    echo "[pre-commit] FAILED: ruff format check failed. Run: ruff format backend/app/ tests/"
    exit 1
fi

echo "[pre-commit] All checks passed."
